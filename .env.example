# Server-side only. Visitors can also paste their own key in the app.
OPENROUTER_API_KEY=

# The secret that seals a reader's own key for the trip from their browser.
# Any string, but it has to be the same on every instance. Without it the app
# keeps the secret in the database, or derives one from the database's address.
API_KEY_SECRET=

# Postgres on Neon. Create the tables with `npm run db:migrate`.
DATABASE_URL=

# Clerk. Accounts are optional; signed in, notes and highlights sync across devices.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical, sitemap and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional; only readers with their own OpenRouter key can use it.
LLAMA_CLOUD_API_KEY=
